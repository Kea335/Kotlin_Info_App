<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (bulud yedəyi və cihazdan cihaza köçürmə). Qayda
     backup_rules.xml ilə eynidir: kompilyator keşi çıxarılır, qalanı gedir. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/kotlinaz_kes.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/kotlinaz_kes.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
