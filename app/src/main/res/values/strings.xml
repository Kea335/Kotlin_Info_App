    <string name="demo_ns_basliq">Null-safety laboratoriyası</string>
    <string name="demo_ns_tesvir">Dəyəri null / dolu et, sonra operatoru seç — nəticəni və izahı dərhal gör.</string>
    <string name="demo_ns_deyer_var">Dəyər var (söndürülübsə null)</string>
    <string name="demo_ns_kompilyasiya">KOMPİLYASİYA XƏTASI</string>
    <string name="demo_ns_cokme">ÇALIŞMA VAXTI ÇÖKMƏSİ</string>
    <string name="demo_ns_netice">NƏTİCƏ</string>
    <string name="demo_ns_ne_bas_verdi">Nə baş verdi?</string>
    <string name="demo_ns_hec_ne">(heç nə çap olunmadı)</string>
    <string name="demo_ns_direct">Kotlin bu kodu işə salmağa belə imkan vermir. Xəta çalışma vaxtında yox, kompilyasiya vaxtında tutulur — yəni istifadəçi onu heç vaxt görməyəcək.</string>
    <string name="demo_ns_safe_null">Safe call operatoru (?.): receiver null-dursa çağırış tamamilə atlanır və nəticə null olur. Çökmə baş vermir.</string>
    <string name="demo_ns_safe_dolu">Receiver null deyil, ona görə length adi qaydada hesablanır.</string>
    <string name="demo_ns_bang_null">!! operatoru «mən zəmanət verirəm ki, null deyil» deməkdir. Səhv etsən — NPE. Mümkün qədər ondan qaçın.</string>
    <string name="demo_ns_bang_dolu">Bu dəfə dəyər null deyildi, ona görə işlədi. Amma !! yenə də risklidir — növbəti dəfə null ola bilər.</string>
    <string name="demo_ns_elvis_null">Elvis operatoru (?:) sol tərəf null olduqda sağ tərəfdəki ehtiyat dəyəri qaytarır.</string>
    <string name="demo_ns_elvis_dolu">Sol tərəf null olmadığı üçün elvisin sağ tərəfi heç işləmir.</string>
    <string name="demo_ns_let_null">let bloku yalnız receiver null olmayanda işlənir. Null olanda bütün blok atlanır.</string>
    <string name="demo_ns_let_dolu">Blok içində it artıq smart-cast olunmuş String tipidir — əlavə ? işarəsinə ehtiyac yoxdur.</string>
    <string name="demo_ns_if_null">Şərti yoxlama false verdi, blok işlənmədi.</string>
    <string name="demo_ns_if_dolu">SMART CAST: null yoxlamasından sonra kompilyator ad-ı avtomatik String kimi görür — ?. yazmağa ehtiyac qalmır.</string>

